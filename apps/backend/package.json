{
  "name": "TCGHub - Backend",
  "version": "0.1.0",
  "engines": {
    "node": ">=26.12.0 <27.0.0"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias",
    "start": "node dist/server.js",
    "dev": "nodemon dist/server.js",
    "test": "NODE_ENV=test vitest",
    "prod": "tsx watch src/server.ts"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.6",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.1",
    "tsc-alias": "^1.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
